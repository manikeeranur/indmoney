# ── INDstocks (IND Money) API ────────────────────────────────────────────────
# Client ID from the dashboard (used as the x-api-key header when minting a token)
IND_CLIENT_ID=
# Your MPIN
IND_MPIN=
# TOTP secret from the dashboard QR code — this is what removes the daily login
IND_TOTP_SECRET=

# Optional overrides
# IND_API_BASE=https://api.indstocks.com
# IND_WS_PRICES=wss://ws-prices.indstocks.com/api/v1/ws/prices
# IND_WS_ORDERS=wss://ws-order-updates.indstocks.com/api/v1/ws/trades

# Signs the browser session cookie (32+ chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3000

# ── MongoDB (shared with the existing Kite app) ──────────────────────────────
MONGODB_URI=

# ── Telegram ─────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_CHAT_ID_OI_SNIPER=
